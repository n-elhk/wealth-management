{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wealth Management",
  "version": "0.1.0",
  "identifier": "fr.wealthmanagement.app",
  "build": {
    "beforeDevCommand": "pnpm serve:tauri",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/wealth-management/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wealth Management — Gestion de patrimoine",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Gestion de patrimoine personnel et de SCI",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
